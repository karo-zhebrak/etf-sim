# Copy to .env (gitignored) and fill in.

# --- Next.js app (public: sent to the browser, protected by RLS) ---
# Same project URL as SUPABASE_URL below.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key: Supabase dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: the public site URL used in auth email links. Defaults to the request's host.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Data pipeline (server-side only). The same three values are GitHub Actions secrets
# for .github/workflows/monthly-data.yml. ---

# Project URL: Supabase dashboard > Project Settings > Data API
SUPABASE_URL=https://<project-ref>.supabase.co

# Postgres connection string (session pooler, port 5432): Supabase dashboard > Connect
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secret / service_role key: Supabase dashboard > Project Settings > API Keys.
# Server-side only (pipeline). Never expose it in the Next.js app or commit it.
SUPABASE_SERVICE_ROLE_KEY=
